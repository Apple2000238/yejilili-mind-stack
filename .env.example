# YeJiLiLi Mind Stack — 环境变量示例
# 复制为 .env 并填入实际值
# ⚠️ 不要将 .env 提交到 Git

# ─── 通用 ───────────────────────────────────────────────────────────────────
ENV=staging
LOG_LEVEL=INFO

# ─── Edge Gateway ────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# 默认 LLM Provider: mock | openai | anthropic
DEFAULT_PROVIDER=mock

# OpenAI 配置（provider=openai 时生效）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic 配置（provider=anthropic 时生效）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─── Nocturne Adapter ────────────────────────────────────────────────────────
ADAPTER_PORT=8001
ADAPTER_HOST=0.0.0.0
# MCP token 由 Docker Secret 注入，不写入 .env

# ─── Nocturne（上游固定快照）──────────────────────────────────────────────────
NOCTURNE_PORT=8000
NOCTURNE_BUCKETS_DIR=/data/buckets

# ─── XinChao（上游固定快照）───────────────────────────────────────────────────
XINCHAO_PORT=3000
XINCHAO_OMBRE_MCP_URL=http://nocturne-adapter:8001/mcp

# ─── PostgreSQL（Continuity Ledger）───────────────────────────────────────────
POSTGRES_HOST=continuity-ledger
POSTGRES_PORT=5432
POSTGRES_DB=continuity_ledger
POSTGRES_USER=continuity
# POSTGRES_PASSWORD 由 Docker Secret 注入

# ─── Webhook（可选）───────────────────────────────────────────────────────────
# OMBRE_HOOK_URL=
# OMBRE_HOOK_SKIP=true
