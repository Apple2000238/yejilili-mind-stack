+    # ── Ledger 关键表快照（非投影表）：保存完整数据以实现完整回滚 ────────────
+    ledger_snapshots = {}
+    try:
+        with get_pg() as pg:
+            for tbl in ["continuity_manifest", "identity_assembly_audit"]:
+                try:
