-    # 使用 SQLite backup API 生成一致性临时快照
-    tmp_path = export_dir / "source-snapshot-temp.db"
-    src = sqlite3.connect(f"file:{source_db}?mode=ro", uri=True)
-    dst = sqlite3.connect(str(tmp_path))
-    src.backup(dst)
