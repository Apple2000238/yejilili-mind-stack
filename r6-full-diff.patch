-    # PRAGMA quick_check
-    check_db = sqlite3.connect(str(tmp_path))
-    quick_check = check_db.execute("PRAGMA quick_check").fetchone()[0]
-    if quick_check != "ok":
-        raise RuntimeError(f"PRAGMA quick_check failed: {quick_check}")
-
-    # Schema fingerprint + row counts
